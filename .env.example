# Nassakh local settings. Copy to .env and adjust; every key has a sensible default for the Mac.
# django-environ does not strip inline comments, so keep comments on their own lines.

# Django
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
# Only when the site is reached through another origin (LAN hostname, tunnel); scheme included.
# CSRF_TRUSTED_ORIGINS=https://nassakh.local
TIME_ZONE=Africa/Tripoli
LOG_LEVEL=INFO

# Services via brew. Django 6.1 needs PostgreSQL 15 or newer: postgresql@17 runs on port 5433
# next to the older postgresql@14 on 5432 (see docs/RUNBOOK.md section 1).
DATABASE_URL=postgres://localhost:5433/nassakh
REDIS_URL=redis://localhost:6379/0

# Run Celery tasks inline in the web process (no workers). Useful for quick manual tests, off by default.
CELERY_TASK_ALWAYS_EAGER=false

# Files. Relative paths are resolved against the repository root.
MEDIA_ROOT=media

# OCR
# OCR_BACKEND: torch (PyTorch on MPS) | mlx | runpod (Qari on a Runpod Serverless GPU, below)
OCR_BACKEND=torch
# OCR_DEVICE: auto | mps | cpu
OCR_DEVICE=auto
OCR_MODELS_DIR=playground/poc/models
OCR_PRIMARY=qari_v03
OCR_SECONDARY=qari_v02
TESSERACT_LANGS=ara+eng
# The PDF's own text layer as a book's text: off, OCR only (the embedded Arabic text is often garbled)
TEXT_LAYER=false
# One pipeline run per page: hours after which a run's claim no longer blocks a new run
RUN_CLAIM_HOURS=12
# The numbers pass (D50): Kraken, in its own environment (`make kraken`), reads Arabic-Indic numbers
NUMBERS_PASS=true
KRAKEN_PYTHON=.venv-kraken/bin/python
KRAKEN_MODEL=models/kraken/all_arabic_scripts.mlmodel
# D92: the models' words take their boxes from Kraken's reading of the printed lines (false: Tesseract's)
KRAKEN_BOXES=true

# Qari on Runpod (OCR_BACKEND=runpod; docs/RUNPOD_SPEC.md, docs/RUNBOOK.md section 18). The API key
# (Runpod console, Settings, API Keys) and the ID of the nassakh-qari-worker endpoint. `make gpu-worker` then
# runs a threads pool of GPU_THREADS (default 4) instead of one solo process.
# RUNPOD_API_KEY=
# RUNPOD_ENDPOINT_ID=
# Another address than Runpod's, e.g. the worker's local server (python handler.py --rp_serve_api)
# RUNPOD_ENDPOINT_URL=http://localhost:8010
# Seconds one request may take including a cold start; seconds /runsync waits before the job is polled;
# attempts for a transient failure (network, 429, 5xx); seconds a job may run on the GPU
# RUNPOD_TIMEOUT_S=600
# RUNPOD_QUEUE_WAIT_S=1800   # D104: how long a job may wait for a free GPU; then the page goes back to the queue
# RUNPOD_REQUEUE_S=300
# RUNPOD_REQUEUE_TIMES=6
# RUNPOD_SYNC_WAIT_S=90
# RUNPOD_RETRIES=4
# RUNPOD_EXECUTION_TIMEOUT_S=300
# Price of one GPU second for the cost estimate in the API log (24 GB GPUs: 0.00019); 0 hides it
# RUNPOD_PRICE_PER_S=0

# Exports (Word, PDF, EPUB): the export task's soft time limit in seconds, the finished files kept per
# book and format, and whether each Word file is validated against the ECMA-376 schemas
EXPORT_SOFT_LIMIT_S=1800
EXPORTS_KEPT=5
EXPORT_VALIDATE=true

# D106: accounts, sign-up and the page quota (docs/RUNBOOK.md section 19).
# Pages a new sign-up is given (0: none, the superuser adds them on «الفوترة») and for how many days;
# days the confirmation link stays valid.
SIGNUP_PAGE_QUOTA=0
SIGNUP_QUOTA_DAYS=30
EMAIL_CONFIRM_DAYS=3
# The site's address for the links in emails (empty: the address the request came to), e.g. https://nassakh.example
# SITE_URL=
# Email: the console in development (`make web` prints the message); SMTP in production.
DEFAULT_FROM_EMAIL=نسّاخ <no-reply@localhost>
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# EMAIL_TIMEOUT=20

# D107/D108: search, quotation checking and the MCP server (docs/RUNBOOK.md section 20).
# Days a page clip's signed link stays valid (an AI client shows it without a session).
CLIP_LINK_DAYS=7
# The MCP server (`make mcp` / `manage.py mcp_serve`): interface and port it listens on; the /mcp URL clients
# connect to (shown in the snippets of «البحث والتحقق»; empty: http://localhost:<port>/mcp), e.g.
# https://nassakh.example/mcp; calls an access key may make a minute. Its clip and review links start with SITE_URL.
MCP_HOST=127.0.0.1
MCP_PORT=8001
# MCP_PUBLIC_URL=
MCP_RATE_LIMIT=60
