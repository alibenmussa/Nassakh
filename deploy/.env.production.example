# Nassakh production settings (docs/DEPLOY.md). Copy to deploy/.env.production, fill the CHANGE_ME lines, and link
# it as .env so docker compose reads it too:
#
#   cp deploy/.env.production.example deploy/.env.production
#   chmod 600 deploy/.env.production
#   ln -sfn deploy/.env.production .env
#
# This file is read by docker compose, not by Django: a value is everything after the `=`, without quotes;
# write a comment on its own line, never after a value; do not use `$` in a value (write `$$` for one dollar).
# deploy/.env.production is never committed (.gitignore). DATABASE_URL and REDIS_URL are set by
# docker-compose.yml from the values below; do not add them here.

# ================================================================== Django
# A long random string; sessions, signed links and the clips' links depend on it (changing it signs everyone
# out and voids the clip links). Make one with:  openssl rand -hex 32
SECRET_KEY=CHANGE_ME
DEBUG=false
# The names the site answers to: the domain, and localhost for the containers' own health checks.
ALLOWED_HOSTS=nassakh.tech,localhost,127.0.0.1
# Origins (scheme included) forms may be posted from; without the right one every login fails the CSRF check.
CSRF_TRUSTED_ORIGINS=https://nassakh.tech
TIME_ZONE=Africa/Tripoli
LOG_LEVEL=INFO

# ================================================================== domain and URLs
# The domain Caddy gets a certificate for (the DNS A records of `@` and `www` must point at this server).
SITE_ADDRESS=nassakh.tech
# The start of the links in emails, clips and the MCP tools' answers.
SITE_URL=https://nassakh.tech
# The /mcp address shown on «ربط مساعد ذكي» (https://<domain>/mcp).
MCP_PUBLIC_URL=https://nassakh.tech/mcp

# ================================================================== behind Caddy (TLS)
# Trust Caddy's X-Forwarded-Proto (only Caddy can reach the web container), so Django knows the request was https.
BEHIND_PROXY=true
# Caddy hands the Host header on unchanged: leave this off.
USE_X_FORWARDED_HOST=false
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
# Caddy already redirects http to https; this makes Django refuse plain http as well.
SECURE_SSL_REDIRECT=true
# HSTS: one hour while you are testing; raise it (86400, then 31536000) once everything works.
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# ================================================================== PostgreSQL 17 (the postgres container)
# Letters and digits only (it goes into a URL):  openssl rand -hex 24
# It is set when the database volume is first created; changing it later does not change the stored password.
POSTGRES_USER=nassakh
POSTGRES_DB=nassakh
POSTGRES_PASSWORD=CHANGE_ME

# ================================================================== OCR: Qari on Runpod Serverless
# The server has no GPU and no local models: pages are read by the nassakh-qari-worker endpoint.
OCR_BACKEND=runpod
# Runpod console, Settings, API Keys; and the ID of the endpoint (docs/RUNBOOK.md section 18).
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# Seconds one request may take including a cold start.
RUNPOD_TIMEOUT_S=600
# D104: how long a job may wait for a free GPU, then the page goes back to the queue after RUNPOD_REQUEUE_S,
# at most RUNPOD_REQUEUE_TIMES times before it is an error.
RUNPOD_QUEUE_WAIT_S=1800
RUNPOD_REQUEUE_S=300
RUNPOD_REQUEUE_TIMES=6
# Seconds /runsync waits before the job is polled; attempts for a transient failure; seconds a job may run.
RUNPOD_SYNC_WAIT_S=90
RUNPOD_RETRIES=4
RUNPOD_EXECUTION_TIMEOUT_S=300
# Price of one GPU second for the cost estimate in Django admin's API log (24 GB GPUs: 0.00019); 0 hides it.
RUNPOD_PRICE_PER_S=0
# Kraken (in the image) reads the Arabic numbers and the word boxes on this server's CPU.
NUMBERS_PASS=true
KRAKEN_BOXES=true

# ================================================================== accounts, sign-up and email (D106, RUNBOOK section 19)
# Pages a new sign-up is given (0: none; the superuser adds them on «الفوترة») and for how many days; days a
# confirmation link stays valid.
SIGNUP_PAGE_QUOTA=0
SIGNUP_QUOTA_DAYS=30
EMAIL_CONFIRM_DAYS=3
# SMTP (Django 6.1 MAILERS). Without a working server the confirmation email is not sent and nobody can sign up.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL="نسّاخ <no-reply@nassakh.tech>"

# ================================================================== search and the MCP server (D107, D108)
# Calls an access key may make a minute, and days a page clip's signed link stays valid.
MCP_RATE_LIMIT=60
CLIP_LINK_DAYS=7

# ================================================================== exports
EXPORT_SOFT_LIMIT_S=1800
EXPORTS_KEPT=5
EXPORT_VALIDATE=true

# ================================================================== sizes (16 GB, 4 vCPU; the memory limits are in docker-compose.yml)
# gunicorn: processes x threads per process, and the seconds a silent worker may live.
WEB_WORKERS=3
WEB_THREADS=2
WEB_TIMEOUT=300
# The CPU worker's processes (each Kraken run takes about 1.5 GB, an export up to 2 GB) and the GPU worker's
# threads (HTTP requests to Runpod at the same time).
WORKER_CONCURRENCY=3
GPU_THREADS=3

# ================================================================== the first superuser (deploy/bootstrap.sh)
# The email is the login (D106). After bootstrap.sh has made the account, delete the ADMIN_PASSWORD line: the
# password lives in the database, and this file is passed to every container.
ADMIN_EMAIL=
ADMIN_PASSWORD=
