# Nassakh on one computer with Docker (docker-compose.local.yml, docs/RUN_LOCALLY.md Path B). Copy it:
#
#   cp deploy/.env.local.example deploy/.env.local
#
# then set SECRET_KEY. This file is read by docker compose, not by Django: a value is everything after the `=`,
# without quotes; write a comment on its own line, never after a value. DATABASE_URL, REDIS_URL and the OCR
# backend are set by docker-compose.local.yml; do not add them here.

# ================================================================== Django
# A long random string. The containers refuse to start with CHANGE_ME. Make one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Riyadh
LOG_LEVEL=INFO
# The start of the links in emails, clips and the MCP tools' answers.
SITE_URL=http://localhost:8000
MCP_PUBLIC_URL=http://localhost:8001/mcp

# ================================================================== plain http on localhost (no TLS proxy)
BEHIND_PROXY=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0

# ================================================================== OCR on the CPU
# The second model. qari_v02 (the default) keeps both models in memory, about 9 GB. qari_v03 keeps only one
# model, about 5 GB, and reads each region twice with it.
OCR_SECONDARY=qari_v02
# Kraken (in the image) reads the Arabic numbers and the word boxes.
NUMBERS_PASS=true
KRAKEN_BOXES=true

# ================================================================== accounts and email (D106)
# Pages a new sign-up is given (0: none; the superuser adds pages on «الفوترة»).
SIGNUP_PAGE_QUOTA=0
SIGNUP_QUOTA_DAYS=30
EMAIL_CONFIRM_DAYS=3
# No mail server here: emails (the sign-up confirmation) are printed in the web log:
#   docker compose -f docker-compose.local.yml logs web
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Nassakh <no-reply@localhost>
