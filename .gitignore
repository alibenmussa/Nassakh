# Python
__pycache__/
*.py[cod]
.venv/
.venv-kraken/
.venv*/
*.egg-info/
build/
.pytest_cache/
.ruff_cache/

# Django
db.sqlite3
media/
staticfiles/
.env

# Production (docs/DEPLOY.md): the server's secrets, and the nightly database dumps next to the clone
deploy/.env.production
backups/

# IDE / OS / assistant tools (Claude Code keeps its sessions, worktrees and memory in .claude/)
.idea/
.vscode/
.DS_Store
.claude/

# Node
node_modules/

# PoC: large generated artefacts (inputs, images, model weights). Keep runs/*.json, gt/, REPORT.md.
playground/poc/input/
playground/poc/pages/
playground/poc/gray/
playground/poc/gray_2x/
playground/poc/bw/
playground/poc/overlays/
playground/poc/models/
playground/poc/tmp/
playground/poc/regions/

# Model weights fetched by `make kraken` (D50)
models/

# The Runpod worker of the Qari models: its own repository (alibenmussa/nassakh-qari-worker), cloned here
workers/

# Digits experiment: environments, models, crops and intermediate files (the scripts, labels, results and
# REPORT.md are kept; crops/ and sheets/ are rebuilt by collect.py from the database)
playground/digits/.venv-*/
playground/digits/models/
playground/digits/crops/
playground/digits/sheets/
playground/digits/lines*.json
playground/digits/areas_*.json
playground/digits/letters*_request.json
playground/digits/letters*_result.json
playground/word/out/
playground/digits/results_lines_*.json
playground/digits/*.err
playground/ux/
playground/phase7/*.jsonl

# Images and PDFs of book pages are never committed: the books are under copyright (playground/README.md).
playground/**/*.png
playground/**/*.jpg
playground/**/*.jpeg
playground/**/*.webp
playground/**/*.tif
playground/**/*.tiff
playground/**/*.pdf
