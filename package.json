{
  "name": "nassakh-frontend",
  "private": true,
  "type": "module",
  "description": "Build-time tooling for the Nassakh UI: Tailwind v4 CSS, the TipTap editor bundle (esbuild) and vendored Alpine.js / fonts. Node is not needed at runtime.",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "build:css": "tailwindcss -i static/src/app.css -o static/dist/app.css --minify",
    "build:editor": "node scripts/build-editor.mjs",
    "watch:css": "tailwindcss -i static/src/app.css -o static/dist/app.css --watch",
    "build": "npm run vendor && npm run build:css && npm run build:editor"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.2.5",
    "@tailwindcss/cli": "^4.1.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-character-count": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "alpinejs": "^3.14.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.0"
  }
}
